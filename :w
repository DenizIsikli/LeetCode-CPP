 #include<bits/stdc++.h>
using namespace std;
class Solution {
public:
    vector<int> countServers(int n, vector<vector<int>>& logs, int x, vector<int>& queries) {
        vector<int>ans;
        for(auto&q:queries){
             int cnt=0;
             int l=q-x,r=q;
             for(auto&log:logs){
                 if(log[1]>=l && log[1]<=r)cnt++;
             }
        }
    }
};
